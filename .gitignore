# Rajo: minimal-but-complete ignore for a public product repo.

# --- Python virtualenvs (any name, any depth): never committed, recreate via scripts/local/01_init ---
.venv/
.venv*
**/.venv*
venv/
**/venv/

# --- Python caches / build ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
build/

# --- Node / web ---
node_modules/
frontend/dist/
frontend/.vite/
# build-time overlay generated by frontend/copy-data.mjs (canonical copies live in data/derived)
frontend/public/data/
frontend/public/models/
frontend/public/ort/
frontend/public/assets/
*.tsbuildinfo
frontend/test-results/
frontend/playwright-report/

# --- Secrets / env: this product has none, but keep the rule ---
.env
.env.*
!.env.example

# --- Raw / heavy data: commit ONLY the compact derived artifacts under data/derived/ ---
data/raw/
data/cache/
*.parquet
*.h5
*.hdf5
*.nc
*.npy
*.npz
*.tif
*.tiff
*.gpkg
*.rar
# checkpoints stay outside git; only the exported ONNX ships
models/*.pt
models/*.pth
models/*.ckpt
*.dll
*.so
*.dylib

# --- OS / logs / editors ---
.DS_Store
Thumbs.db
*.log
.vscode/*
!.vscode/settings.json
