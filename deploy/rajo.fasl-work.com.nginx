# Rajo, static site on nginx. Installed as /etc/nginx/sites-available/rajo.fasl-work.com and symlinked
# into sites-enabled; certbot --nginx adds the TLS block and the HTTP to HTTPS redirect.
server {
    server_name rajo.fasl-work.com;
    root /var/www/rajo.fasl-work.com;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/geo+json image/svg+xml application/wasm;
    gzip_min_length 1024;

    # a `types` block at server level REPLACES the http-level mapping (nginx inherits the directive as a
    # whole), so the standard table is included first and the extra extensions merged into it; without
    # the include, index.html and the hashed .js would be served as application/octet-stream
    include /etc/nginx/mime.types;
    types {
        application/octet-stream onnx;
        application/octet-stream bin;
        application/wasm wasm;
        application/geo+json geojson;
    }

    # the app shell is never cached: it names the hashed assets
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # hashed build assets are immutable
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # the Data PAGE is a client-side route that shares its name with the artifact prefix: the exact
    # path (with or without the slash) serves the app shell; anything below /data/ is an artifact.
    # Without these two blocks nginx redirected /data to /data/ (a real directory) and the artifact
    # rule answered 404 for the page (found by the live smoke on the first deploy, 2026-09-03)
    location = /data {
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }
    location = /data/ {
        add_header Cache-Control "no-cache";
        try_files /index.html =404;
    }

    # baked artifacts change with a release; a missing artifact answers 404, never the app shell
    # (the browser decoders treat a non-PNG tile as missing, and a 200 with HTML hid a missing tile
    # behind "The source image could not be decoded")
    location /data/ {
        add_header Cache-Control "public, max-age=86400";
        add_header Access-Control-Allow-Origin "*";
        try_files $uri =404;
    }

    # the architecture diagrams are fetched by the modal, which refuses anything but image/svg+xml
    location /svg/ {
        add_header Cache-Control "public, max-age=86400";
        try_files $uri =404;
    }

    # models, the flat-array forest and the onnxruntime wasm are large and change rarely
    location /models/ {
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }
    location /ort/ {
        add_header Cache-Control "public, max-age=604800";
        try_files $uri =404;
    }

    # every other path is a client-side route of the single-page app
    location / {
        try_files $uri $uri/ /index.html;
    }

    listen 80;
}
