# Rajo, static site on nginx. Installed as /etc/nginx/sites-available/rajo.fasl-work.com and symlinked
# into sites-enabled; certbot --nginx adds the TLS block and the HTTP to HTTPS redirect.
server {
    server_name rajo.fasl-work.com;
    root /var/www/rajo.fasl-work.com;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript application/geo+json image/svg+xml application/wasm;
    gzip_min_length 1024;

    types {
        application/octet-stream onnx;
        application/wasm wasm;
        application/geo+json geojson;
    }

    # the app shell is never cached: it names the hashed assets
    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    # hashed build assets are immutable
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # baked artifacts change with a release
    location /data/ {
        add_header Cache-Control "public, max-age=86400";
        add_header Access-Control-Allow-Origin "*";
    }

    # models and wasm are large and change rarely
    location ~* \.(onnx|wasm)$ {
        add_header Cache-Control "public, max-age=604800";
    }

    location / {
        try_files $uri $uri/ /index.html;
    }

    listen 80;
}
